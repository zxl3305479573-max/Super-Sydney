{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["desktop/**/*.ts", "desktop/**/*.tsx", "bridge/**/*.ts", "electron.vite.config.ts"]
}

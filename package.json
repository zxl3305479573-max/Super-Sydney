{
  "name": "sydney-work-os",
  "version": "0.1.0",
  "description": "Sydney personal AI work OS desktop client",
  "author": "Sydney",
  "main": "out/main/main.js",
  "private": true,
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -Unpacked",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test desktop/test/*.test.*",
    "cloud": "python cloud_api/main.py"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
